# Inventory Service Environment Variables
NODE_ENV=development
PORT=4002
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL connection string
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://shopsphere:secret_local_dev_password@localhost:5432/inventory_db

# Admin API Secret for manual stock adjustments
ADMIN_API_SECRET=dev_inventory_admin_secret_key_change_in_prod
