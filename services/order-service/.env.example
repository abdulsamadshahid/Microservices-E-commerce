# Order Service Environment Variables
NODE_ENV=development
PORT=4003
LOG_LEVEL=info
CORS_ORIGIN=*

# PostgreSQL connection string
DATABASE_URL=postgres://shopsphere:secret_local_dev_password@localhost:5432/order_db

# Security & Authentication
JWT_SECRET=shopsphere_dev_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h

# Inter-service URLs (REST over HTTP)
PRODUCT_SERVICE_URL=http://localhost:4001
INVENTORY_SERVICE_URL=http://localhost:4002
