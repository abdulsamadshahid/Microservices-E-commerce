{
  "openapi": "3.0.3",
  "info": {
    "title": "ShopSphere Microservices API",
    "version": "1.0.0",
    "description": "Production-grade RESTful API documentation for ShopSphere microservices: Product Service, Inventory Service, and Order Service."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development API Gateway (Same-origin)"
    },
    {
      "url": "http://localhost:4001",
      "description": "Product Service (Standalone)"
    },
    {
      "url": "http://localhost:4002",
      "description": "Inventory Service (Standalone)"
    },
    {
      "url": "http://localhost:4003",
      "description": "Order Service (Standalone)"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "summary": "List product catalog",
        "description": "Returns all products with optional text search and category filtering.",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Search keyword matching name or description"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter by product category (e.g. Audio, Electronics, Home & Office, Apparel)"
          }
        ],
        "responses": {
          "200": {
            "description": "List of products",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "count": 8,
                  "data": [
                    {
                      "id": "prod-1",
                      "name": "AeroPulse ANC Wireless Headphones",
                      "description": "Active noise cancelling with 40-hour battery life",
                      "price_cents": 24999,
                      "category": "Audio",
                      "image_url": "https://images.unsplash.com/photo-1505740420928-5e560c06d30e"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "summary": "Get product by ID",
        "tags": ["Products"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Product details" },
          "404": { "description": "Product not found" }
        }
      }
    },
    "/api/inventory/{productId}": {
      "get": {
        "summary": "Check available stock for a product",
        "tags": ["Inventory"],
        "parameters": [
          {
            "name": "productId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory status",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "data": {
                    "productId": "prod-1",
                    "availableStock": 25,
                    "reservedStock": 0,
                    "inStock": true
                  }
                }
              }
            }
          },
          "404": { "description": "Product inventory not found" }
        }
      }
    },
    "/api/inventory/reservations": {
      "post": {
        "summary": "Atomically reserve stock for an order",
        "tags": ["Inventory"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "orderId": "order-12345",
                "items": [{ "productId": "prod-1", "quantity": 2 }]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Stock successfully reserved" },
          "409": { "description": "Insufficient inventory (cannot oversell)" }
        }
      }
    },
    "/api/inventory/reservations/release": {
      "post": {
        "summary": "Compensation: Release reserved stock on order failure",
        "tags": ["Inventory"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "orderId": "order-12345",
                "items": [{ "productId": "prod-1", "quantity": 2 }]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Reserved stock restored" }
        }
      }
    },
    "/api/inventory/adjustments": {
      "post": {
        "summary": "Adjust product stock level (Admin only)",
        "tags": ["Inventory"],
        "security": [{ "AdminAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "productId": "prod-1",
                "stock": 50
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Stock adjusted" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "summary": "Register customer account",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "customer@example.com",
                "password": "strongPassword123",
                "name": "Alex Taylor"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Registered and JWT returned" },
          "409": { "description": "Email already exists" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "Login with credentials",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "email": "alice@example.com",
                "password": "password123"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Login successful, returns JWT" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "tags": ["Authentication"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/orders": {
      "post": {
        "summary": "Place an order with atomic stock reservation",
        "tags": ["Orders"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "Unique key to prevent duplicate orders on retry"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "idempotencyKey": "cart-checkout-uuid-1",
                "items": [{ "productId": "prod-1", "quantity": 1 }]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Order created and confirmed" },
          "409": { "description": "Insufficient inventory" },
          "500": { "description": "Persistence failure (triggers compensation)" }
        }
      },
      "get": {
        "summary": "List orders belonging to authenticated user",
        "tags": ["Orders"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "User's order history" }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "summary": "Get order details (enforces user ownership)",
        "tags": ["Orders"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": { "description": "Order details" },
          "403": { "description": "Forbidden - order belongs to another user" },
          "404": { "description": "Order not found" }
        }
      }
    },
    "/health/live": {
      "get": {
        "summary": "Liveness probe",
        "tags": ["Health"],
        "responses": {
          "200": { "description": "Process is running" }
        }
      }
    },
    "/health/ready": {
      "get": {
        "summary": "Readiness probe",
        "tags": ["Health"],
        "responses": {
          "200": { "description": "Service dependencies and database are healthy" },
          "503": { "description": "Dependency is down" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "AdminAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
